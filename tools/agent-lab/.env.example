# Cualquier API compatible con POST /v1/chat/completions.
# Ejemplos: un proveedor cloud, LiteLLM Proxy o un servidor local.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=pon_tu_clave_aqui
MODEL_NAME=pon_el_modelo_aqui
# Modelo opcional para el documenter del laboratorio; la orquestación principal sigue en Codex/Kimi.
MODEL_AGENT_DOCUMENTER=gemini-3.1-pro

# Ruta local persistente. No guardes esta base de datos en Git.
AGENT_DB=data/agent.sqlite3
AGENT_USER=tesista
AGENT_MAX_STEPS=8
AGENT_PROFILE_DIR=agents/tesis
# El valor . activa la autodetección desde la carpeta actual hacia sus padres.
AGENT_PROJECT_ROOT=.
OBSIDIAN_VAULT_DIR=.
